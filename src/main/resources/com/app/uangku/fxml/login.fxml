<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="auth-root" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.uangku.controller.AuthController">
    <VBox alignment="CENTER" styleClass="auth-panel" HBox.hgrow="ALWAYS">
        <VBox maxWidth="560" minHeight="600" spacing="24" styleClass="auth-card">
            <HBox alignment="CENTER" spacing="14" styleClass="auth-form-brand-row">
                <Label text="&#9635;" styleClass="auth-logo" />
                <Label text="UangKu" styleClass="auth-form-brand" />
            </HBox>

            <VBox spacing="8">
                <Label text="Username" styleClass="field-label" />
                <TextField fx:id="usernameField" />
            </VBox>

            <VBox spacing="8">
                <Label text="Password" styleClass="field-label" />
                <PasswordField fx:id="passwordField" />
            </VBox>

            <Button text="Masuk" maxWidth="Infinity" styleClass="primary-button" onAction="#showDashboard" />

            <HBox alignment="CENTER" spacing="6">
                <Label text="Belum punya akun?" styleClass="muted-text" />
                <Button text="Daftar" styleClass="link-button" onAction="#showRegister" />
            </HBox>
        </VBox>
    </VBox>

    <VBox alignment="CENTER_LEFT" prefWidth="468" spacing="32" styleClass="auth-hero">
        <VBox spacing="2">
            <Label text="Kelola Keuangan" styleClass="auth-title" />
            <Label text="dengan Mudah" styleClass="auth-title" />
        </VBox>
        <Label text="Pantau pemasukan, pengeluaran, dan anggaran Anda dalam satu tempat. Simple, elegant, dan efisien." styleClass="auth-copy" wrapText="true" />
        <VBox spacing="18">
            <Label text="&#8226;  Tracking transaksi real-time" styleClass="auth-benefit" />
            <Label text="&#8226;  Budget planning per kategori" styleClass="auth-benefit" />
            <Label text="&#8226;  Laporan visual yang informatif" styleClass="auth-benefit" wrapText="true" />
        </VBox>
    </VBox>
</HBox>
