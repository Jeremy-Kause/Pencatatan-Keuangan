<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.uangku.controller.ReportController">
    <left>
        <VBox prefWidth="250" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="sidebar-logo">
                <StackPane prefHeight="62" prefWidth="62" styleClass="sidebar-logo-mark">
                    <SVGPath content="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2v2" scaleX="1.2" scaleY="1.2" styleClass="sidebar-logo-icon" />
                    <SVGPath content="M16 12h5v5h-5a2.5 2.5 0 0 1 0-5Z" scaleX="1.2" scaleY="1.2" styleClass="sidebar-logo-icon" />
                </StackPane>
                <Label text="UangKu" styleClass="sidebar-brand" />
            </HBox>
            <Region prefHeight="1" styleClass="sidebar-divider" />
            <VBox spacing="12" styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showDashboard">
                    <graphic>
                        <SVGPath content="M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button text="Transaksi" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showTransactions">
                    <graphic>
                        <SVGPath content="M6 3h12v18l-3-2-3 2-3-2-3 2z M9 8h6 M9 12h6 M9 16h4" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button text="Kategori" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showCategories">
                    <graphic>
                        <SVGPath content="M4 12 12 4h7v7l-8 8z M16 8h1" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button text="Anggaran" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showBudgets">
                    <graphic>
                        <SVGPath content="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2v2 M16 13h5v4h-5a2 2 0 0 1 0-4Z" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button id="activeNav" text="Laporan" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showReports">
                    <graphic>
                        <SVGPath content="M12 3v9h9A9 9 0 1 1 12 3z M15 3.5A9 9 0 0 1 20.5 9H15z" styleClass="nav-icon" />
                    </graphic>
                </Button>
            </VBox>
            <Region prefHeight="1" styleClass="sidebar-divider" />
            <Button text="Logout" maxWidth="Infinity" styleClass="logout-button" onAction="#logout">
                <graphic>
                    <SVGPath content="M10 17l5-5-5-5 M15 12H3 M21 4v16" styleClass="nav-icon" />
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="22" styleClass="content">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label styleClass="page-title" text="Laporan" />
                            <Label styleClass="page-subtitle" text="Analisis pengeluaran berdasarkan kategori" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="reportMonthComboBox" prefWidth="160" promptText="Bulan ini" />
                    </HBox>

                    <GridPane hgap="18" vgap="18">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="62" />
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="38" />
                        </columnConstraints>

                        <VBox spacing="14" styleClass="panel" GridPane.columnIndex="0">
                            <Label styleClass="section-title" text="Piechart" />
                            <StackPane prefHeight="430">
                                <PieChart fx:id="expensePieChart" labelsVisible="true" legendVisible="true" title="Pengeluaran per Kategori" />
                            </StackPane>
                        </VBox>

                        <VBox spacing="14" styleClass="panel" GridPane.columnIndex="1">
                            <Label styleClass="section-title" text="Data Statistik" wrapText="true" />
                            <VBox spacing="10">
                                <VBox spacing="6" styleClass="stat-card">
                                    <Label styleClass="metric-label" text="Total Pengeluaran" />
                                    <Label fx:id="reportTotalExpenseLabel" styleClass="metric-value" text="Rp 500.000" />
                                </VBox>
                                <VBox spacing="6" styleClass="stat-card">
                                    <Label styleClass="metric-label" text="Kategori Terbesar" />
                                    <Label fx:id="topCategoryLabel" styleClass="section-title" text="Makan dan Minum" />
                                    <Label fx:id="topCategoryPercentLabel" styleClass="muted-text" text="0% dari total pengeluaran" />
                                </VBox>
                                <VBox spacing="6" styleClass="stat-card">
                                    <Label styleClass="metric-label" text="Jumlah Transaksi" />
                                    <Label fx:id="transactionCountLabel" styleClass="section-title" text="18 transaksi" />
                                </VBox>
                                <VBox spacing="6" styleClass="stat-card">
                                    <Label styleClass="metric-label" text="Catatan" />
                                    <Label fx:id="reportNoteLabel" styleClass="muted-text" text="Laporan bulan ini akan muncul di sini." wrapText="true" />
                                </VBox>
                            </VBox>
                        </VBox>
                  <rowConstraints>
                     <RowConstraints />
                  </rowConstraints>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
