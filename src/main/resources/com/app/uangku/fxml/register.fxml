<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="auth-root" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.uangku.controller.AuthController">
    <VBox alignment="CENTER_LEFT" spacing="22" styleClass="auth-hero" HBox.hgrow="ALWAYS">
        <Label text="UangKu" styleClass="auth-brand" />
        <VBox spacing="10">
            <Label text="Kelola Keuangan dengan Mudah" styleClass="auth-title" wrapText="true" />
            <Label text="Pantau pemasukan, pengeluaran, dan anggaran Anda dalam satu tempat. Simple, elegant, dan efisien." styleClass="auth-copy" wrapText="true" />
        </VBox>
    </VBox>

    <VBox alignment="CENTER" prefWidth="430" styleClass="auth-panel">
        <VBox maxWidth="330" spacing="16">
            <VBox spacing="6">
                <Label text="Daftar" styleClass="auth-card-title" />
                <Label text="Buat akun UangKu baru" styleClass="auth-card-subtitle" />
            </VBox>

            <VBox spacing="8">
                <Label text="Username" styleClass="field-label" />
                <TextField fx:id="registerUsernameField" promptText="Username" />
            </VBox>

            <VBox spacing="8">
                <Label text="Email" styleClass="field-label" />
                <TextField fx:id="emailField" promptText="Email" />
            </VBox>

            <VBox spacing="8">
                <Label text="Password" styleClass="field-label" />
                <PasswordField fx:id="registerPasswordField" promptText="Password" />
            </VBox>

            <Button text="Daftar" maxWidth="Infinity" styleClass="primary-button" onAction="#handleRegister" />
            <Label fx:id="registerMessageLabel" text="" styleClass="danger-text" wrapText="true" />

            <HBox alignment="CENTER" spacing="6">
                <Label text="Sudah punya akun?" styleClass="muted-text" />
                <Button text="Masuk" styleClass="link-button" onAction="#showLogin" />
            </HBox>
        </VBox>
    </VBox>
</HBox>
