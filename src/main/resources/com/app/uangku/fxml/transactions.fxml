<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.uangku.controller.TransactionController">
    <left>
        <VBox prefWidth="252" spacing="0" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="sidebar-brand-row">
                <Label text="&#9635;" styleClass="sidebar-logo" />
                <Label text="UangKu" styleClass="sidebar-brand" />
            </HBox>
            <Region styleClass="sidebar-separator" />
            <VBox spacing="12" styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Button text="&#9638; Dashboard" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showDashboard" />
                <Button id="activeNav" text="&#9636; Transaksi" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showTransactions" />
                <Button text="&#9671; Kategori" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showCategories" />
                <Button text="&#9635; Anggaran" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showBudgets" />
                <Button text="&#9684; Laporan" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showReports" />
            </VBox>
            <Region styleClass="sidebar-separator" />
            <Button text="&#8618; Logout" maxWidth="Infinity" styleClass="logout-button" onAction="#showLogin" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="48" styleClass="content">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Transaksi" styleClass="page-title" />
                            <Label text="Kelola semua pemasukan dan pengeluaran Anda" styleClass="page-subtitle" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button id="actionButton" text="+  Tambah Transaksi" styleClass="primary-button" />
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="filter-bar">
                        <TextField fx:id="searchTransactionField" promptText="cari....." prefWidth="210" />
                        <Region prefWidth="16" />
                        <ToggleButton fx:id="allFilterButton" selected="true" text="Semua" />
                        <ToggleButton fx:id="incomeFilterButton" text="Pemasukan" />
                        <ToggleButton fx:id="expenseFilterButton" text="Pengeluaran" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="categoryFilterComboBox" promptText="Semua Kategori" prefWidth="175" />
                    </HBox>

                    <VBox spacing="14">
                        <Label text="Transaksi" styleClass="section-title" />
                        <VBox spacing="7">
                            <HBox alignment="CENTER_LEFT" styleClass="placeholder-card">
                                <Label text="KONTEN 1" styleClass="placeholder-title" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" styleClass="placeholder-card">
                                <Label text="KONTEN 2" styleClass="placeholder-title" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" styleClass="placeholder-card">
                                <Label text="KONTEN 3" styleClass="placeholder-title" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" styleClass="placeholder-card">
                                <Label text="KONTEN 4" styleClass="placeholder-title" />
                            </HBox>
                        </VBox>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
