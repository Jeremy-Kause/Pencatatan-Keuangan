<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane styleClass="app-shell" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.uangku.controller.CategoryController">
    <left>
        <VBox prefWidth="250" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="sidebar-logo">
                <StackPane prefHeight="62" prefWidth="62" styleClass="sidebar-logo-mark">
                    <SVGPath content="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2v2" scaleX="1.2" scaleY="1.2" styleClass="sidebar-logo-icon" />
                    <SVGPath content="M16 12h5v5h-5a2.5 2.5 0 0 1 0-5Z" scaleX="1.2" scaleY="1.2" styleClass="sidebar-logo-icon" />
                </StackPane>
                <Label text="UangKu" styleClass="sidebar-brand" />
            </HBox>
            <Region prefHeight="1" styleClass="sidebar-divider" />
            <VBox spacing="12" styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Button text="Dashboard" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showDashboard">
                    <graphic>
                        <SVGPath content="M3 3h7v7H3z M14 3h7v7h-7z M3 14h7v7H3z M14 14h7v7h-7z" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button text="Transaksi" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showTransactions">
                    <graphic>
                        <SVGPath content="M6 3h12v18l-3-2-3 2-3-2-3 2z M9 8h6 M9 12h6 M9 16h4" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button id="activeNav" text="Kategori" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showCategories">
                    <graphic>
                        <SVGPath content="M4 12 12 4h7v7l-8 8z M16 8h1" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button text="Anggaran" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showBudgets">
                    <graphic>
                        <SVGPath content="M20 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2v2 M16 13h5v4h-5a2 2 0 0 1 0-4Z" styleClass="nav-icon" />
                    </graphic>
                </Button>
                <Button text="Laporan" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showReports">
                    <graphic>
                        <SVGPath content="M12 3v9h9A9 9 0 1 1 12 3z M15 3.5A9 9 0 0 1 20.5 9H15z" styleClass="nav-icon" />
                    </graphic>
                </Button>
            </VBox>
            <Region prefHeight="1" styleClass="sidebar-divider" />
            <Button text="Logout" maxWidth="Infinity" styleClass="logout-button" onAction="#logout">
                <graphic>
                    <SVGPath content="M10 17l5-5-5-5 M15 12H3 M21 4v16" styleClass="nav-icon" />
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="22" styleClass="content">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Kategori" styleClass="page-title" />
                            <Label text="Kelola kategori pemasukan dan pengeluaran" styleClass="page-subtitle" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <GridPane hgap="18" vgap="18">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="36" hgrow="ALWAYS" />
                            <ColumnConstraints percentWidth="64" hgrow="ALWAYS" />
                        </columnConstraints>

                        <VBox spacing="12" styleClass="panel" GridPane.columnIndex="0">
                            <Label text="Tambah Kategori" styleClass="section-title" />
                            <VBox spacing="7">
                                <Label text="Nama Kategori" styleClass="field-label" />
                                <TextField fx:id="categoryNameField" promptText="Contoh: Gaji, Makan" onAction="#handleSaveCategory" />
                            </VBox>
                            <VBox spacing="7">
                                <Label text="Tipe" styleClass="field-label" />
                                <ComboBox fx:id="categoryTypeComboBox" promptText="Pemasukan / Pengeluaran" maxWidth="Infinity" onAction="#handleSaveCategory" />
                            </VBox>
                            <Label fx:id="categoryMessageLabel" text="" styleClass="danger-text" wrapText="true" />
                            <Button fx:id="saveCategoryButton" text="Simpan Kategori" maxWidth="Infinity" defaultButton="true" styleClass="primary-button" onAction="#handleSaveCategory" />
                            <Button fx:id="cancelEditCategoryButton" text="Batal Edit" maxWidth="Infinity" managed="false" visible="false" styleClass="secondary-button" onAction="#handleCancelEditCategory" />
                        </VBox>

                        <GridPane hgap="18" vgap="18" GridPane.columnIndex="1">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" />
                            </columnConstraints>

                            <VBox spacing="14" styleClass="panel" GridPane.columnIndex="0">
                                <Label text="Kategori Pemasukan" styleClass="section-title" />
                                <VBox fx:id="incomeCategoryList" spacing="10" />
                            </VBox>

                            <VBox spacing="14" styleClass="panel" GridPane.columnIndex="1">
                                <Label text="Kategori Pengeluaran" styleClass="section-title" />
                                <VBox fx:id="expenseCategoryList" spacing="10" />
                            </VBox>
                        </GridPane>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
