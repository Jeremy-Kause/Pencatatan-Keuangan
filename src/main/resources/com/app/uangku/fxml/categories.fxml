<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.app.uangku.controller.CategoryController">
    <left>
        <VBox prefWidth="252" spacing="0" styleClass="sidebar">
            <HBox alignment="CENTER_LEFT" spacing="14" styleClass="sidebar-brand-row">
                <Label text="&#9635;" styleClass="sidebar-logo" />
                <Label text="UangKu" styleClass="sidebar-brand" />
            </HBox>
            <Region styleClass="sidebar-separator" />
            <VBox spacing="12" styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Button text="&#9638; Dashboard" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showDashboard" />
                <Button text="&#9636; Transaksi" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showTransactions" />
                <Button id="activeNav" text="&#9671; Kategori" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showCategories" />
                <Button text="&#9635; Anggaran" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showBudgets" />
                <Button text="&#9684; Laporan" maxWidth="Infinity" styleClass="sidebar-button" onAction="#showReports" />
            </VBox>
            <Region styleClass="sidebar-separator" />
            <Button text="&#8618; Logout" maxWidth="Infinity" styleClass="logout-button" onAction="#showLogin" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="22" styleClass="content">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Kategori" styleClass="page-title" />
                            <Label text="Kelola kategori pemasukan dan pengeluaran" styleClass="page-subtitle" />
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Tambah Kategori" styleClass="primary-button" />
                    </HBox>

                    <GridPane hgap="18" vgap="18">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="36" hgrow="ALWAYS" />
                            <ColumnConstraints percentWidth="64" hgrow="ALWAYS" />
                        </columnConstraints>

                        <VBox spacing="12" styleClass="panel" GridPane.columnIndex="0">
                            <Label text="Tambah Kategori" styleClass="section-title" />
                            <VBox spacing="7">
                                <Label text="Nama Kategori" styleClass="field-label" />
                                <TextField fx:id="categoryNameField" promptText="Contoh: Gaji, Makan" />
                            </VBox>
                            <VBox spacing="7">
                                <Label text="Tipe" styleClass="field-label" />
                                <ComboBox fx:id="categoryTypeComboBox" promptText="Pemasukan / Pengeluaran" maxWidth="Infinity" />
                            </VBox>
                            <Button text="Simpan Kategori" maxWidth="Infinity" styleClass="primary-button" />
                        </VBox>

                        <GridPane hgap="18" vgap="18" GridPane.columnIndex="1">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" />
                                <ColumnConstraints percentWidth="50" hgrow="ALWAYS" />
                            </columnConstraints>

                            <VBox spacing="14" styleClass="panel" GridPane.columnIndex="0">
                                <Label text="Kategori Pemasukan" styleClass="section-title" />
                                <VBox spacing="10">
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="category-card">
                                        <Label text="KONTEN 1" styleClass="placeholder-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Edit" styleClass="secondary-button" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="category-card">
                                        <Label text="KONTEN 2" styleClass="placeholder-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Edit" styleClass="secondary-button" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="category-card">
                                        <Label text="KONTEN 3" styleClass="placeholder-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Edit" styleClass="secondary-button" />
                                    </HBox>
                                </VBox>
                            </VBox>

                            <VBox spacing="14" styleClass="panel" GridPane.columnIndex="1">
                                <Label text="Kategori Pengeluaran" styleClass="section-title" />
                                <VBox spacing="10">
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="category-card">
                                        <Label text="KONTEN 4" styleClass="placeholder-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Edit" styleClass="secondary-button" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="category-card">
                                        <Label text="KONTEN 5" styleClass="placeholder-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Edit" styleClass="secondary-button" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="category-card">
                                        <Label text="KONTEN 6" styleClass="placeholder-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Edit" styleClass="secondary-button" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="category-card">
                                        <Label text="KONTEN 7" styleClass="placeholder-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Edit" styleClass="secondary-button" />
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="category-card">
                                        <Label text="KONTEN 8" styleClass="placeholder-title" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button text="Edit" styleClass="secondary-button" />
                                    </HBox>
                                </VBox>
                            </VBox>
                        </GridPane>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
